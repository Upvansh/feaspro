# ==============================================================================
# FeasPro Environment Configuration Template
# Copy this file to .env and configure your local/production credentials.
# DO NOT commit real secrets or production keys to version control.
# ==============================================================================

# Application Metadata
PROJECT_NAME="FeasPro - Property Development Feasibility Platform"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Security & Authentication
# Generate a strong secret with: openssl rand -hex 32
SECRET_KEY="your-super-secret-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection - Supabase PostgreSQL (or any hosted PostgreSQL)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# Example (Direct Connection):
# DATABASE_URL="postgresql+psycopg://postgres:your-supabase-password@db.your-project-ref.supabase.co:5432/postgres"
# Example (Connection Pooler):
# DATABASE_URL="postgresql+psycopg://postgres.your-project-ref:your-supabase-password@aws-0-region.pooler.supabase.com:6543/postgres"
DATABASE_URL="postgresql+psycopg://postgres:<password>@<host>:5432/postgres"

# CORS Allowed Origins (JSON array or comma-separated list)
BACKEND_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]'
